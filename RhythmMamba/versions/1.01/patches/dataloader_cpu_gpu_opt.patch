+def _env_int(name, default):
+    value = os.environ.get(name)
+    if value is None:
+        return default
+    try:
+        return int(value)
+    except ValueError:
+        print(f"Invalid {name}={value!r}; using {default}.")
+        return default
+
+
+def _env_bool(name, default):
+    value = os.environ.get(name)
+    if value is None:
+        return default
+    return value.lower() in ("1", "true", "yes", "y", "on")
+
+
+def build_data_loader(dataset, batch_size, shuffle, generator, config, split_name):
+    """Create a DataLoader with tunable CPU/GPU transfer settings."""
+    split_key = split_name.upper()
+    num_workers = _env_int(
+        f"RHYTHMMAMBA_{split_key}_NUM_WORKERS",
+        _env_int("RHYTHMMAMBA_NUM_WORKERS", 4)
+    )
+    pin_memory = _env_bool(
+        f"RHYTHMMAMBA_{split_key}_PIN_MEMORY",
+        _env_bool("RHYTHMMAMBA_PIN_MEMORY", str(config.DEVICE).startswith("cuda"))
+    )
+
+    loader_kwargs = dict(
+        dataset=dataset,
+        num_workers=num_workers,
+        batch_size=batch_size,
+        shuffle=shuffle,
+        worker_init_fn=seed_worker,
+        generator=generator,
+        pin_memory=pin_memory,
+    )
+
+    if num_workers > 0:
+        loader_kwargs["persistent_workers"] = _env_bool(
+            f"RHYTHMMAMBA_{split_key}_PERSISTENT_WORKERS",
+            _env_bool("RHYTHMMAMBA_PERSISTENT_WORKERS", True)
+        )
+        loader_kwargs["prefetch_factor"] = _env_int(
+            f"RHYTHMMAMBA_{split_key}_PREFETCH_FACTOR",
+            _env_int("RHYTHMMAMBA_PREFETCH_FACTOR", 2)
+        )
+
+    print(
+        f"{split_name} DataLoader: batch_size={batch_size}, "
+        f"num_workers={num_workers}, pin_memory={pin_memory}, "
+        f"persistent_workers={loader_kwargs.get('persistent_workers', False)}, "
+        f"prefetch_factor={loader_kwargs.get('prefetch_factor', None)}"
+    )
+    return DataLoader(**loader_kwargs)
+
